{
  "Cache": {
    "Provider": "inmemory"
  },
  "Compatibility": {
    "UseLegacyCreditSchema": true
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      }
    ]
  },
  "Telegram": {
    "ApplicationName": "",
    "BotId": "",
    "ChatId": "",
    "AdminChatId": "",
    "ErrorChatId": "",
    "AWSBot": ""
  },
  "AppSettings": {
    "LogTable": "APILOG",
    "LogFilePath": "Logs\\brokerapi-log-.txt",
    "Secret": "CHANGE_ME",
    "TokenExpireDay": 10,
    "ApiBaseUrl": "https://localhost:44375",
    "UseCache": true,
    "BrokerName": "CHANGE_ME",
    "MailSendingActive": true,
    "ConnectionString": "Data Source=SERVER;Initial Catalog=DATABASE;User ID=USER;TrustServerCertificate=True;",
    "DbPassword": "CHANGE_ME"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "PaymentUrl": "https://example.com"
}
