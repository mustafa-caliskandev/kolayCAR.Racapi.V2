{
  "info": {
    "_postman_id": "8b3d3c92-8f0d-4c87-a75c-0a7f9f9b9d01",
    "name": "Vonarent Remote API v1.0",
    "description": "Postman collection generated from Vonarent Remote API v1.0 documentation. Set baseUrl, apiKey and secretKey before running. The collection pre-request script creates x-api-key, x-timestamp and x-signature headers using METHOD|path|timestamp|queryString|bodyString. Non-auth requests also receive Authorization: Bearer {{bearerToken}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const apiKey = pm.variables.get('apiKey') || '';",
          "const secretKey = pm.variables.get('secretKey') || '';",
          "const bearerToken = pm.variables.get('bearerToken') || '';",
          "const timestamp = Date.now().toString();",
          "const method = pm.request.method.toUpperCase();",
          "",
          "function resolve(value) {",
          "  return pm.variables.replaceIn(value == null ? '' : String(value));",
          "}",
          "",
          "const pathParts = (pm.request.url.path || []).map(resolve).filter(Boolean);",
          "const path = '/' + pathParts.join('/');",
          "",
          "const queryString = pm.request.url.query.all()",
          "  .filter(q => !q.disabled)",
          "  .map(q => ({ key: resolve(q.key), value: resolve(q.value) }))",
          "  .filter(q => q.key && q.value !== '')",
          "  .sort((a, b) => a.key.localeCompare(b.key))",
          "  .map(q => `${q.key}=${q.value}`)",
          "  .join('&');",
          "",
          "let bodyString = '';",
          "if (pm.request.body && pm.request.body.mode === 'raw') {",
          "  const rawBody = resolve(pm.request.body.raw || '').trim();",
          "  if (rawBody) {",
          "    try {",
          "      bodyString = JSON.stringify(JSON.parse(rawBody));",
          "      pm.request.body.update(bodyString);",
          "    } catch (error) {",
          "      bodyString = rawBody;",
          "    }",
          "  }",
          "}",
          "",
          "const message = `${method}|${path}|${timestamp}|${queryString}|${bodyString}`;",
          "const signature = CryptoJS.HmacSHA256(message, secretKey).toString(CryptoJS.enc.Hex).toLowerCase();",
          "",
          "pm.request.headers.upsert({ key: 'x-api-key', value: apiKey });",
          "pm.request.headers.upsert({ key: 'x-timestamp', value: timestamp });",
          "pm.request.headers.upsert({ key: 'x-signature', value: signature });",
          "",
          "if (path.includes('/api/remote/v1/auth/')) {",
          "  pm.request.headers.remove('Authorization');",
          "} else if (bearerToken) {",
          "  pm.request.headers.upsert({ key: 'Authorization', value: `Bearer ${bearerToken}` });",
          "}",
          "",
          "pm.collectionVariables.set('lastSignatureMessage', message);"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "1. Authenticate",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP status is successful', function () {",
                  "  pm.expect(pm.response.code).to.be.within(200, 299);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "pm.test('Vonarent status is 1', function () {",
                  "  pm.expect(json.status).to.eql(1);",
                  "});",
                  "",
                  "if (json.token) pm.collectionVariables.set('bearerToken', json.token);",
                  "if (json.refreshToken) pm.collectionVariables.set('refreshToken', json.refreshToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/remote/v1/auth/authenticate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "remote",
                "v1",
                "auth",
                "authenticate"
              ]
            },
            "description": "Gets JWT access token and refresh token. This request is signed but does not send Authorization."
          },
          "response": []
        },
        {
          "name": "2. Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP status is successful', function () {",
                  "  pm.expect(pm.response.code).to.be.within(200, 299);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "if (json.token) pm.collectionVariables.set('bearerToken', json.token);",
                  "if (json.refreshToken) pm.collectionVariables.set('refreshToken', json.refreshToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{bearerToken}}\",\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/remote/v1/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "remote",
                "v1",
                "auth",
                "refresh"
              ]
            },
            "description": "Refreshes an expired JWT token. This is an auth endpoint, so Authorization is not added by the collection script."
          },
          "response": []
        }
      ]
    },
    {
